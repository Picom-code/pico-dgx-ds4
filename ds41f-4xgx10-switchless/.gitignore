# large or regenerable artefacts
golden/*.pt
golden/*.log
ref/techreport.txt
ref/inventory.json
ref/ext/
ref/inference/examples/
micro/bw
micro/mma
micro/rdma_lat
# The build's dependency cache is downloaded, so it is not committed. The
# manifest and the two scripts beside it are source: they pin and fetch what the
# cache holds, so they are committed.
build/cache/
build/__pycache__/
build-*/
target/
.claude/
*.o
*.so
__pycache__/
# never commit secrets (API key files, .env files)
*.key
.env
micro/hostmem
